# copy this file to credentials.env and fill in the values (never commit credentials.env)
# every bat file loads it through bat_file\load_credentials.bat

# reqres.in free API key. Public and not a secret - the default inside
# Resources\Library\env_config.py is already reqres-free-v1. Set it here only if
# you have your own key.
REQRES_API_KEY=reqres-free-v1

# the test account of the-internet.herokuapp.com is published in the assignment,
# so it lives in Resources\Settings\Settings.robot. A real project would put it here:
# WEB_PASSWORD=
